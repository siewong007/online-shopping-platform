# Root-only runtime configuration for the online-shopping encrypted off-server backups.
#
# Install the REAL file at /opt/online-shopping/backup.env with mode 0600, owned by root:
#   sudo install -m 0600 backup.env.example /opt/online-shopping/backup.env && sudo nano /opt/online-shopping/backup.env
#
# This template is safe to commit: it contains no secrets. Never commit the real /opt/online-shopping/backup.env.
#
# The backup FAILS CLOSED if encryption or off-server configuration is missing: it never silently
# degrades to an unencrypted or local-only backup.

# Age public recipient (public material). The matching private identity must live OFF this server
# and OFF the backup bucket; it is only ever needed during a restore. Generate once with:
#   age-keygen -o ~/ekoway-backup-age.txt   # keep this file safe, off-server
#   age-keygen -y ~/ekoway-backup-age.txt   # prints the recipient to paste below
BACKUP_AGE_RECIPIENT=

# rclone remote name and destination directory for the off-server copy. Configure the rclone remote
# in a root-only rclone config (see docs/backup-restore-runbook.md). Credentials never live in Git.
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PATH=

# Bounds on every rclone call so a hung network can never hang the backup (H2). Values are Go
# durations, e.g. "15s", "120s".
BACKUP_RCLONE_CONTIMEOUT=15s
BACKUP_RCLONE_TIMEOUT=120s

# Optional database password. If set, it is exported and forwarded to the container with
# `docker exec -e PGPASSWORD` (env-by-name), so the value NEVER appears on a command line
# (/proc/*/cmdline or `ps`). Do NOT paste the value into the command line yourself.
# BACKUP_DB_PASSWORD=

# Local encrypted archive directory (root-owned, mode 0700). Contains only .dump.age files.
BACKUP_LOCAL_DIR=/opt/online-shopping/backups

# Retention (all counts are "keep the newest N"). Local is a simple copy count; remote tiers keep
# N daily backups and N weekly backups. The weekly tier is the run that lands on BACKUP_WEEKLY_DAY.
BACKUP_LOCAL_RETENTION_COUNT=3
BACKUP_REMOTE_DAILY_RETENTION=14
BACKUP_REMOTE_WEEKLY_RETENTION=8
# Day of week for the weekly tier: 1=Mon .. 7=Sun. Default 7 (Sunday).
BACKUP_WEEKLY_DAY=7

# Database to dump. Defaults match the production stack; leave unchanged unless you know better.
BACKUP_DB_CONTAINER=online-shopping-db
BACKUP_DB_USER=shop_admin
BACKUP_DB_NAME=online_shopping