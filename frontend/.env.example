# Copy to frontend/.env for local overrides. Do not commit frontend/.env.

# Pickup shopping is on by default. Set false to hide add-to-cart.
# VITE_ENABLE_PURCHASE=true

# Delivery stays off until rates exist.
# VITE_ENABLE_DELIVERY=false

# Online card/FPX (HitPay) stays off until production keys exist.
# VITE_ENABLE_CARD_PAY=false
