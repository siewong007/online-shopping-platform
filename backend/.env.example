APP_HOST=127.0.0.1
APP_PORT=4000
# Set to `production` on the live server. This disables the legacy unpaid checkout route.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://project_depot:project_depot@localhost:5433/project_depot
# Trusted reverse-proxy hops in front of the API for the admin-login throttle
# client key. Production edge is a single Caddy reverse_proxy (default 1: the
# last X-Forwarded-For element). Raise only when another trusted proxy hop is
# verifiably added; each extra hop widens the shared per-client bucket.
TRUSTED_PROXY_HOPS=1
# Server-side gate on NEW payment initiation. Exactly three values are accepted:
#   disabled   - reject every new payment initiation (the default when unset or blank);
#   controlled - reject normal customers; admit one short-lived single-use UAT authorization
#                issued by a super admin at POST /api/admin/payments/activation-grants and
#                presented in the X-Payment-Activation request header;
#   public     - normal secure checkout.
# Any other value stops the API at startup. Webhooks, refunds and reconciliation for payments
# that already exist keep working in every mode.
PAYMENT_ACTIVATION_MODE=disabled

# Leave these blank until senangPay has approved your account. Sandbox is the safe default;
# change to `live` only after a successful sandbox transaction and callback setup.
# Leave PAYMENT_PRIMARY_PROVIDER blank to preserve the existing credential-based senangPay
# fallback. Set it only after the selected provider adapter passes sandbox verification.
PAYMENT_PRIMARY_PROVIDER=
SENANGPAY_MERCHANT_ID=
SENANGPAY_SECRET_KEY=
SENANGPAY_MODE=sandbox

# HitPay is disabled unless PAYMENT_PRIMARY_PROVIDER=hitpay and a complete credential pair is
# present. Sandbox accepts the legacy HITPAY_API_KEY/HITPAY_WEBHOOK_SALT names for local
# compatibility, but new environments should use the explicit sandbox names below.
HITPAY_MODE=sandbox
HITPAY_SANDBOX_API_KEY=
HITPAY_SANDBOX_WEBHOOK_SALT=
HITPAY_SANDBOX_API_URL=https://api.sandbox.hit-pay.com
HITPAY_REDIRECT_URL=http://localhost:5173/shop?payment_return=hitpay

# Production activation requires changing HITPAY_MODE and supplying this separate pair.
# Never copy sandbox values here. The adapter fixes the live API host to api.hit-pay.com and
# refuses generic/sandbox credentials while production mode is selected.
HITPAY_PRODUCTION_API_KEY=
HITPAY_PRODUCTION_WEBHOOK_SALT=
HITPAY_PRODUCTION_API_URL=https://api.hit-pay.com
